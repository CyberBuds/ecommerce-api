  schemaJsonLd        Json?
  openGraph           Json?
  twitterCard         Json?
  seoScore            Int?
  searchKeywords     String?
  isFeatured          Boolean            @default(false)
  isTrending          Boolean            @default(false)
  isBestSeller        Boolean            @default(false)
  isNewArrival        Boolean            @default(false)
  status              ProductStatus      @default(DRAFT)
  publishedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  createdBy           Int?
  updatedBy           Int?
  variants            ProductVariant[]
  images              ProductMedia[]
  attributes          ProductAttribute[]
  tags                ProductTag[]
  relations           ProductRelation[] @relation("ProductRelationParent")
  relatedBy           ProductRelation[] @relation("ProductRelationTarget")
  wishlistItems       CustomerWishlist[]
  reviews             CustomerReview[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  dealOfTheDay        DealOfTheDay[]
  purchaseOrderItems  PurchaseOrderItem[]
  grnItems            GoodsReceiptNoteItem[]
  stockAdjustments    StockAdjustment[]
  stockTransfers      StockTransfer[]
  inventoryAuditLogs  InventoryAuditLog[]
  stockMovements      StockMovement[]
  inventories         Inventory[]
  auditLogs           ProductAuditLog[]
}

model ProductVariant {
  id             Int                  @id @default(autoincrement())
  product        Product              @relation(fields: [productId], references: [id])
  productId      Int
  variantCode    String?              @unique
  sku            String               @unique
  barcode        String?
  colorId        Int?
  sizeId         Int?
  weight         Float?
  length         Float?
  width          Float?
  height         Float?
  costPrice      Decimal?
  sellingPrice   Decimal?
  mrp            Decimal?
  discountType   DiscountType?        @default(NONE)
  discountValue  Decimal?
  taxAmount      Decimal?
  netAmount      Decimal?
  stock          Int                  @default(0)
  minimumStock   Int?                 @default(0)
  maximumStock   Int?                 @default(0)
  status         ProductVariantStatus @default(ACTIVE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  purchaseOrderItems PurchaseOrderItem[]
  grnItems            GoodsReceiptNoteItem[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  dealOfTheDay        DealOfTheDay[]
  stockAdjustments    StockAdjustment[]
  stockTransfers      StockTransfer[]
  inventoryAuditLogs  InventoryAuditLog[]
  stockMovements StockMovement[]
  inventories    Inventory[]
  wishlistItems  CustomerWishlist[]
  reviews        CustomerReview[]
}

model ProductMedia {
  id            Int       @id @default(autoincrement())
  product       Product   @relation(fields: [productId], references: [id])
  productId     Int
  mediaType     MediaType @default(IMAGE)
  imageUrl      String
  isPrimary     Boolean   @default(false)
  displayOrder  Int       @default(0)
  altText       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Attribute {
  id           Int                 @id @default(autoincrement())
  name         String
  code         String              @unique
  description  String?
  slug         String              @unique
  status       MasterStatus        @default(ACTIVE)
  isActive     Boolean             @default(true)
  isDeleted    Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  createdBy    Int?
  updatedBy    Int?
  values       AttributeValue[]
}

model AttributeValue {
  id                 Int                @id @default(autoincrement())
  attribute          Attribute          @relation(fields: [attributeId], references: [id])
  attributeId        Int
  value              String
  code               String?
  slug               String?
  status             MasterStatus       @default(ACTIVE)
  isActive           Boolean            @default(true)
  isDeleted          Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  createdBy          Int?
  updatedBy          Int?
  productAttributes  ProductAttribute[]

  @@unique([attributeId, value])
}

model ProductAttribute {
  product          Product        @relation(fields: [productId], references: [id])
  productId        Int
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id])
  attributeValueId Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@id([productId, attributeValueId])
}

model ProductTag {
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  tag       Tag     @relation(fields: [tagId], references: [id])
  tagId     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([productId, tagId])
}

model ProductRelation {
  id               Int              @id @default(autoincrement())
  product          Product          @relation("ProductRelationParent", fields: [productId], references: [id])
  productId        Int
  relatedProduct   Product          @relation("ProductRelationTarget", fields: [relatedProductId], references: [id])
  relatedProductId Int
  relationType     ProductRelationType
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([productId, relatedProductId, relationType])
}

model ProductAuditLog {
  id          Int        @id @default(autoincrement())
  product     Product    @relation(fields: [productId], references: [id])
  productId   Int
  actorId     Int?
  action      String
  details     Json?
  previous    Json?
  createdAt   DateTime   @default(now())
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum InventoryStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  RESERVED
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
  LOST
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING
  APPROVED
  PARTIAL
  COMPLETED
  CANCELLED
  REJECTED
}

enum GRNStatus {
  PARTIAL_RECEIVED
  COMPLETE_RECEIVED
  REJECTED
}

enum StockAdjustmentType {
  INCREASE
  DECREASE
}

enum StockAdjustmentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum StockTransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
  REJECTED
}

model Warehouse {
  id                  Int                  @id @default(autoincrement())
  warehouseCode       String               @unique
  warehouseName       String
  contactPerson       String?
  phone               String?
  email               String?
  address             String?
  city                String?
  state               String?
  country             String?
  pincode             String?
  status              WarehouseStatus      @default(ACTIVE)
  inventories         Inventory[]
  stockMovements      StockMovement[]
  grns                GoodsReceiptNote[]
  stockAdjustments    StockAdjustment[]
  outgoingTransfers   StockTransfer[]      @relation("SourceWarehouse")
  incomingTransfers   StockTransfer[]      @relation("DestinationWarehouse")
  auditLogs           InventoryAuditLog[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  createdBy           Int?
  updatedBy           Int?
}

model Supplier {
  id             Int             @id @default(autoincrement())
  supplierCode   String          @unique
  supplierName   String
  gstNumber      String?
  contactPerson  String?
  mobile         String?
  email          String?
  address        String?
  city           String?
  state          String?
  country        String?
  pincode        String?
  status         SupplierStatus  @default(ACTIVE)
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdBy      Int?
  updatedBy      Int?
}

model Inventory {
  id             Int             @id @default(autoincrement())
  product        Product         @relation(fields: [productId], references: [id])
  productId      Int
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  variantId      Int?
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])
  warehouseId    Int
  currentStock   Int             @default(0)
  reservedStock  Int             @default(0)
  availableStock Int             @default(0)
  minimumStock   Int             @default(0)
  maximumStock   Int             @default(0)
  reorderLevel   Int             @default(0)
  status         InventoryStatus @default(ACTIVE)
  stockMovements StockMovement[]
  auditLogs      InventoryAuditLog[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdBy      Int?
  updatedBy      Int?

  @@unique([productId, variantId, warehouseId])
}

model StockMovement {
  id              Int                 @id @default(autoincrement())
  product         Product             @relation(fields: [productId], references: [id])
  productId       Int
  variant         ProductVariant?     @relation(fields: [variantId], references: [id])
  variantId       Int?
  warehouse       Warehouse           @relation(fields: [warehouseId], references: [id])
  warehouseId     Int
  inventory       Inventory?          @relation(fields: [inventoryId], references: [id])
  inventoryId     Int?
  movementType    StockMovementType
  quantity        Int
  referenceNumber String?
  remarks         String?
  date            DateTime            @default(now())
  purchaseOrder   PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId Int?
  grn             GoodsReceiptNote?   @relation(fields: [grnId], references: [id])
  grnId           Int?
  stockTransfer   StockTransfer?      @relation(fields: [stockTransferId], references: [id])
  stockTransferId Int?
  stockAdjustment StockAdjustment?    @relation(fields: [stockAdjustmentId], references: [id])
  stockAdjustmentId Int?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model PurchaseOrder {
  id            Int                 @id @default(autoincrement())
  poNumber      String              @unique
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  supplierId    Int
  orderDate     DateTime
  expectedDate  DateTime?
  status        PurchaseOrderStatus @default(PENDING)
  totalAmount   Decimal             @default(0)
  taxAmount     Decimal             @default(0)
  netAmount     Decimal             @default(0)
  remarks       String?
  items         PurchaseOrderItem[]
  stockMovements StockMovement[]
  grns          GoodsReceiptNote[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  createdBy     Int?
  updatedBy     Int?
}

model PurchaseOrderItem {
  id             Int            @id @default(autoincrement())
  purchaseOrder  PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId Int
  product        Product        @relation(fields: [productId], references: [id])
  productId      Int
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  variantId      Int?
  quantity       Int
  rate           Decimal
  discount       Decimal?        @default(0)
  gst            Decimal?        @default(0)
  netAmount      Decimal
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model GoodsReceiptNote {
  id                 Int                    @id @default(autoincrement())
  grnNumber          String                 @unique
  purchaseOrder      PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId    Int
  warehouse          Warehouse              @relation(fields: [warehouseId], references: [id])
  warehouseId        Int
  receivedDate       DateTime              @default(now())
  status             GRNStatus             @default(PARTIAL_RECEIVED)
  totalReceivedAmount Decimal              @default(0)
  rejectedQuantity   Int                    @default(0)
  remarks            String?
  items              GoodsReceiptNoteItem[]
  stockMovements     StockMovement[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  createdBy          Int?
  updatedBy          Int?
}

model GoodsReceiptNoteItem {
  id               Int                @id @default(autoincrement())
  grn              GoodsReceiptNote   @relation(fields: [grnId], references: [id])
  grnId            Int
  product          Product            @relation(fields: [productId], references: [id])
  productId        Int
  variant          ProductVariant?    @relation(fields: [variantId], references: [id])
  variantId        Int?
  quantity         Int
  receivedQuantity Int
  rejectedQuantity Int                @default(0)
  rate             Decimal?
  netAmount        Decimal?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model StockAdjustment {
  id               Int                    @id @default(autoincrement())
  adjustmentNumber String                 @unique
  product          Product                @relation(fields: [productId], references: [id])
  productId        Int
  variant          ProductVariant?        @relation(fields: [variantId], references: [id])
  variantId        Int?
  warehouse        Warehouse              @relation(fields: [warehouseId], references: [id])
  warehouseId      Int
  adjustmentType   StockAdjustmentType
  quantity         Int
  reason           String
  status           StockAdjustmentStatus @default(PENDING)
  referenceNumber  String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  stockMovements   StockMovement[]
  createdBy        Int?
  updatedBy        Int?
}

model StockTransfer {
  id                    Int                 @id @default(autoincrement())
  transferNumber        String              @unique
  product               Product             @relation(fields: [productId], references: [id])
  productId             Int
  variant               ProductVariant?     @relation(fields: [variantId], references: [id])
  variantId             Int?
  sourceWarehouse       Warehouse           @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  sourceWarehouseId     Int
  destinationWarehouse  Warehouse           @relation("DestinationWarehouse", fields: [destinationWarehouseId], references: [id])
  destinationWarehouseId Int
  quantity              Int
  status                StockTransferStatus @default(PENDING)
  referenceNumber       String?
  remarks               String?
  transferredAt         DateTime?
  stockMovements        StockMovement[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  createdBy             Int?
  updatedBy             Int?
}

model InventoryAuditLog {
  id          Int        @id @default(autoincrement())
  inventory   Inventory? @relation(fields: [inventoryId], references: [id])
  inventoryId Int?
  product     Product    @relation(fields: [productId], references: [id])
  productId   Int
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  variantId   Int?
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id])
  warehouseId Int
  actorId     Int?
  action      String
  details     Json?
  previous    Json?
  createdAt   DateTime   @default(now())
}

enum ProductRelationType {
  RELATED
  FREQUENTLY_BOUGHT_TOGETHER
  CROSS_SELL
  UP_SELL
}

// ============================================================
// CMS, Content Management & SEO Models
// ============================================================

enum CmsPageStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum CmsPageType {
  LANDING
  CONTENT
  HOME
  CATEGORY
  CUSTOM
}

enum CmsVisibility {
  PUBLIC
  PRIVATE
  PASSWORD_PROTECTED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum FaqStatus {
  ACTIVE
  INACTIVE
}

enum TestimonialStatus {
  ACTIVE
  INACTIVE
}

enum LookbookStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PolicyType {
  PRIVACY_POLICY
  TERMS_AND_CONDITIONS
  REFUND_POLICY
  SHIPPING_POLICY
  CANCELLATION_POLICY
  COOKIE_POLICY
}

enum ContactInquiryStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum MenuType {
  HEADER
  MEGA
  FOOTER
  MOBILE
}

enum RedirectType {
  PERMANENT_301
  TEMPORARY_302
}

enum SeoPageType {
  HOME
  PRODUCT
  CATEGORY
  BLOG
  CMS_PAGE
  LANDING_PAGE
  BRAND
  CUSTOM
}

enum ContentVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// CMS Pages
model CmsPage {
  id               Int             @id @default(autoincrement())
  pageCode         String          @unique
  title            String
  slug             String          @unique
  shortDescription String?
  content          String?         @db.LongText
  featuredImageId  Int?
  template         String?
  layout           String?
  pageType         CmsPageType     @default(CONTENT)
  visibility       CmsVisibility   @default(PUBLIC)
  status           CmsPageStatus   @default(DRAFT)
  publishedAt      DateTime?
  createdBy        Int?
  updatedBy        Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  seoMeta          SeoMeta?
  versions         ContentVersion[]
}

// Blog Category
model BlogCategory {
  id           Int         @id @default(autoincrement())
  categoryName String
  slug         String      @unique
  description  String?
  displayOrder Int         @default(0)
  status       FaqStatus   @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  posts        BlogPost[]
}

// Blog Tags
model BlogTag {
  id        Int        @id @default(autoincrement())
  tagName   String
  slug      String     @unique
  createdAt DateTime   @default(now())
  posts     BlogPostTag[]
}

// Blog Posts
model BlogPost {
  id              Int           @id @default(autoincrement())
  title           String
  slug            String        @unique
  excerpt         String?
  content         String?       @db.LongText
  featuredImageId Int?
  authorId        Int?
  category        BlogCategory? @relation(fields: [categoryId], references: [id])
  categoryId      Int?
  readingTime     Int?
  views           Int           @default(0)
  likes           Int           @default(0)
  commentsEnabled Boolean       @default(true)
  status          BlogStatus    @default(DRAFT)
  publishedAt     DateTime?
  scheduledAt     DateTime?
  createdBy       Int?
  updatedBy       Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tags            BlogPostTag[]
  seoMeta         SeoMeta?
  versions        ContentVersion[]
}

// Blog Post Tags (junction)
model BlogPostTag {
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int
  tag       BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     Int

  @@id([postId, tagId])
}

// FAQs
model Faq {
  id           Int       @id @default(autoincrement())
  question     String
  answer       String    @db.LongText
  category     String?
  displayOrder Int       @default(0)
  status       FaqStatus @default(ACTIVE)
  createdBy    Int?
  updatedBy    Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Testimonials
model Testimonial {
  id           Int               @id @default(autoincrement())
  customerName String
  designation  String?
  company      String?
  imageId      Int?
  review       String            @db.Text
  rating       Int               @default(5)
  displayOrder Int               @default(0)
  status       TestimonialStatus @default(ACTIVE)
  createdBy    Int?
  updatedBy    Int?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

// Lookbooks
model Lookbook {
  id             Int            @id @default(autoincrement())
  collectionName String
  season         String?
  description    String?        @db.Text
  bannerImageId  Int?
  galleryImages  Json?
  status         LookbookStatus @default(DRAFT)
  publishedAt    DateTime?
  createdBy      Int?
  updatedBy      Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

// Style Guides
model StyleGuide {
  id          Int       @id @default(autoincrement())
  guideName   String
  description String?   @db.Text
  images      Json?
  products    Json?
  status      FaqStatus @default(ACTIVE)
  createdBy   Int?
  updatedBy   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Size Guides
model SizeGuide {
  id              Int       @id @default(autoincrement())
  category        String
  brand           String?
  measurementUnit String    @default("cm")
  chart           Json
  images          Json?
  status          FaqStatus @default(ACTIVE)
  createdBy       Int?
  updatedBy       Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Static Policies
model Policy {
  id         Int        @id @default(autoincrement())
  policyType PolicyType @unique
  title      String
  content    String     @db.LongText
  isActive   Boolean    @default(true)
  updatedBy  Int?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  versions   ContentVersion[]
}

// Contact Us Information
model ContactInfo {
  id             Int      @id @default(autoincrement())
  companyName    String
  address        String?  @db.Text
  phone          String?
  email          String?
  whatsapp       String?
  googleMapUrl   String?
  businessHours  Json?
  isActive       Boolean  @default(true)
  updatedBy      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Contact Inquiries
model ContactInquiry {
  id           Int                  @id @default(autoincrement())
  customerName String
  email        String
  mobile       String?
  subject      String
  message      String               @db.Text
  attachmentId Int?
  status       ContactInquiryStatus @default(NEW)
  assignedTo   Int?
  resolvedAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

// Dynamic Menus
model DynamicMenu {
  id           Int       @id @default(autoincrement())
  menuCode     String    @unique
  menuType     MenuType
  title        String
  items        Json
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  createdBy    Int?
  updatedBy    Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Footer Management
model FooterConfig {
  id           Int      @id @default(autoincrement())
  configCode   String   @unique
  columns      Json?
  quickLinks   Json?
  categories   Json?
  services     Json?
  newsletter   Json?
  copyright    String?
  isActive     Boolean  @default(true)
  updatedBy    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Social Media Links
model SocialMediaLink {
  id        Int      @id @default(autoincrement())
  platform  String   @unique
  url       String
  iconClass String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// SEO Meta
model SeoMeta {
  id            Int         @id @default(autoincrement())
  pageType      SeoPageType
  referenceId   Int?
  slug          String?     @unique
  metaTitle     String?
  metaDesc      String?     @db.Text
  metaKeywords  String?
  canonicalUrl  String?
  robotsMeta    String?     @default("index, follow")
  ogTitle       String?
  ogDescription String?     @db.Text
  ogImageId     Int?
  twitterTitle  String?
  twitterDesc   String?     @db.Text
  twitterCard   String?     @default("summary_large_image")
  schemaJson    Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  cmsPage       CmsPage?    @relation(fields: [cmsPageId], references: [id])
  cmsPageId     Int?        @unique
  blogPost      BlogPost?   @relation(fields: [blogPostId], references: [id])
  blogPostId    Int?        @unique
}

// Sitemap Entry
model SitemapEntry {
  id            Int      @id @default(autoincrement())
  url           String   @unique
  changeFreq    String   @default("weekly")
  priority      Float    @default(0.5)
  lastModified  DateTime @default(now())
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Robots.txt Configuration
model RobotsConfig {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  isActive  Boolean  @default(true)
  updatedBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Redirect Manager
model Redirect {
  id             Int          @id @default(autoincrement())
  sourceUrl      String       @unique
  destinationUrl String
  redirectType   RedirectType @default(PERMANENT_301)
  hitCount       Int          @default(0)
  isActive       Boolean      @default(true)
  createdBy      Int?
  updatedBy      Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// URL Rewrite
model UrlRewrite {
  id        Int      @id @default(autoincrement())
  oldUrl    String   @unique
  newUrl    String
  isActive  Boolean  @default(true)
  createdBy Int?
  updatedBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// Reports, Analytics & Business Intelligence Models
// ============================================================

enum ReportScheduleFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ReportScheduleStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum ReportExportFormat {
  EXCEL
  CSV
  PDF
  JSON
}

enum ReportExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ScheduledReport {
  id          Int                     @id @default(autoincrement())
  reportCode  String                  @unique
  reportName  String
  reportType  String
  frequency   ReportScheduleFrequency
  filters     Json?
  recipients  Json?
  nextRunAt   DateTime
  lastRunAt   DateTime?
  status      ReportScheduleStatus    @default(ACTIVE)
  createdBy   Int?
  updatedBy   Int?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

model ReportExportLog {
  id          Int                @id @default(autoincrement())
  reportType  String
  format      ReportExportFormat
  filters     Json?
  filePath    String?
  fileSize    Int?
  status      ReportExportStatus @default(PENDING)
  requestedBy Int?
  completedAt DateTime?
  error       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

// Content Version History
model ContentVersion {
  id          Int                  @id @default(autoincrement())
  entityType  String
  entityId    Int
  version     Int
  content     Json
  status      ContentVersionStatus @default(DRAFT)
  changedBy   Int?
  changedAt   DateTime             @default(now())
  cmsPage     CmsPage?             @relation(fields: [cmsPageId], references: [id])
  cmsPageId   Int?
  blogPost    BlogPost?            @relation(fields: [blogPostId], references: [id])
  blogPostId  Int?
  policy      Policy?              @relation(fields: [policyId], references: [id])
  policyId    Int?
}

