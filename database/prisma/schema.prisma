generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PermissionAction {
  VIEW
  CREATE
  UPDATE
  DELETE
  EXPORT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MasterStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

model Role {
  id          Int               @id @default(autoincrement())
  name        String            @unique
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("role")
}

model Permission {
  id          Int               @id @default(autoincrement())
  resource    String
  action      PermissionAction
  roles       RolePermission[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([resource, action])

  @@map("permission")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  role         Role       @relation(fields: [roleId], references: [id])
  roleId       Int
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId Int

  @@unique([roleId, permissionId])

  @@map("role_permission")
}

model User {
  id            Int            @id @default(autoincrement())
  employeeCode  String?        @unique
  firstName     String
  lastName      String
  email         String         @unique
  mobile        String?        @unique
  password      String
  profileImage  String?
  gender        Gender?
  dateOfBirth   DateTime?
  role          Role?          @relation(fields: [roleId], references: [id])
  roleId        Int?
  status        UserStatus     @default(ACTIVE)
  isActive      Boolean        @default(true)
  isLocked      Boolean        @default(false)
  lastLogin     DateTime?
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdBy     Int?
  updatedBy     Int?

    @@map("user")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
    @@map("refreshtoken")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CustomerAddressType {
  BILLING
  SHIPPING
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  REFUND
  REWARD
  ADJUSTMENT
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  EXPIRE
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum CustomerActivityType {
  LOGIN
  LOGOUT
  REGISTER
  PROFILE_UPDATE
  PASSWORD_CHANGE
  WISHLIST
  ORDERS
  REVIEWS
}

enum CustomerReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model CustomerGroup {
  id           Int          @id @default(autoincrement())
  name         String       @unique
  code         String       @unique
  description  String?
  status       MasterStatus @default(ACTIVE)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdBy    Int?
  updatedBy    Int?
  customers    Customer[]
}

model Customer {
  id                Int                       @id @default(autoincrement())
  customerCode      String                    @unique
  firstName         String
  lastName          String
  email             String                    @unique
  mobile            String?                   @unique
  gender            Gender?
  dateOfBirth       DateTime?
  anniversaryDate   DateTime?
  profileImage      String?
  referralCode      String?                   @unique
  referredBy        Customer?                 @relation("CustomerReferrals", fields: [referredById], references: [id])
  referredById      Int?
  referredCustomers Customer[]               @relation("CustomerReferrals")
  walletBalance     Decimal                   @default(0)
  loyaltyPoints     Int                       @default(0)
  status            CustomerStatus            @default(ACTIVE)
  isEmailVerified   Boolean                   @default(false)
  isMobileVerified  Boolean                   @default(false)
  lastLogin         DateTime?
  customerGroup     CustomerGroup?            @relation(fields: [customerGroupId], references: [id])
  customerGroupId   Int?
  addresses         CustomerAddress[]
  wishlist          CustomerWishlist[]
  reviews           CustomerReview[]
  walletTransactions CustomerWalletTransaction[]
  storeCreditTransactions StoreCreditTransaction[]
  loyaltyTransactions LoyaltyTransaction[]
  notifications     CustomerNotification[]
  activityLogs      CustomerActivityLog[]
  notes             CustomerNote[]
  documents         CustomerDocument[]
  savedCarts        SavedCart[]
  carts             Cart[]
  orders            Order[]
  payments          Payment[]
  couponUsages      CouponUsage[]
  abandonedCartRecoveries AbandonedCartRecovery[]
  creditNotes       CreditNote[]
  debitNotes        DebitNote[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  createdBy         Int?
  updatedBy         Int?
}

model CustomerAddress {
  id               Int                 @id @default(autoincrement())
  customer         Customer            @relation(fields: [customerId], references: [id])
  customerId       Int
  addressType      CustomerAddressType
  isDefaultBilling Boolean             @default(false)
  isDefaultShipping Boolean            @default(false)
  addressLine1     String
  addressLine2     String?
  city             String
  state            String
  country          String
  pincode          String
  latitude         Float?
  longitude        Float?
  status           MasterStatus        @default(ACTIVE)
  billingOrders    Order[]             @relation("OrderBillingAddress")
  shippingOrders   Order[]             @relation("OrderShippingAddress")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  createdBy        Int?
  updatedBy        Int?
}

model CustomerWishlist {
  id         Int            @id @default(autoincrement())
  customer   Customer       @relation(fields: [customerId], references: [id])
  customerId Int
  product    Product        @relation(fields: [productId], references: [id])
  productId  Int
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  variantId  Int?
  addedAt    DateTime       @default(now())

  @@unique([customerId, productId, variantId])
}

model CustomerReview {
  id           Int                 @id @default(autoincrement())
  customer     Customer            @relation(fields: [customerId], references: [id])
  customerId   Int
  product      Product             @relation(fields: [productId], references: [id])
  productId    Int
  variant      ProductVariant?     @relation(fields: [variantId], references: [id])
  variantId    Int?
  rating       Int
  reviewTitle  String
  review       String
  images       Json?
  status       CustomerReviewStatus @default(PENDING)
  approvedBy   Int?
  approvedDate DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model CustomerWalletTransaction {
  id            Int                   @id @default(autoincrement())
  customer      Customer              @relation(fields: [customerId], references: [id])
  customerId    Int
  type          WalletTransactionType
  amount        Decimal
  reference     String?
  remarks       String?
  balanceAfter  Decimal
  createdAt     DateTime              @default(now())
}

model LoyaltyTransaction {
  id            Int                   @id @default(autoincrement())
  customer      Customer              @relation(fields: [customerId], references: [id])
  customerId    Int
  type          LoyaltyTransactionType
  points        Int
  reference     String?
  remarks       String?
  balanceAfter  Int
  createdAt     DateTime              @default(now())
}

model CustomerNotification {
  id          Int                 @id @default(autoincrement())
  customer    Customer            @relation(fields: [customerId], references: [id])
  customerId  Int
  channel     NotificationChannel
  title       String
  message     String
  status      NotificationStatus @default(PENDING)
  isRead      Boolean             @default(false)
  sentAt      DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model CustomerActivityLog {
  id           Int                  @id @default(autoincrement())
  customer     Customer             @relation(fields: [customerId], references: [id])
  customerId   Int
  activityType CustomerActivityType
  referenceId  Int?
  description  String?
  createdAt    DateTime             @default(now())
}

model CustomerNote {
  id          Int        @id @default(autoincrement())
  customer    Customer   @relation(fields: [customerId], references: [id])
  customerId  Int
  note        String
  createdBy   Int?
  updatedBy   Int?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model CustomerDocument {
  id           Int        @id @default(autoincrement())
  customer     Customer   @relation(fields: [customerId], references: [id])
  customerId   Int
  fileName     String
  fileUrl      String
  documentType String?
  status       MasterStatus @default(ACTIVE)
  uploadedBy   Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum CartStatus {
  ACTIVE
  SAVED
  COMPLETED
  ABANDONED
}

enum CouponType {
  PERCENTAGE
  FLAT
  FREE_SHIPPING
}

model Cart {
  id               Int             @id @default(autoincrement())
  customer         Customer?       @relation(fields: [customerId], references: [id])
  customerId       Int?
  sessionId        String?         @unique
  items            CartItem[]
  coupon           Coupon?         @relation(fields: [couponId], references: [id])
  couponId         Int?
  shippingMethod   ShippingMethod? @relation(fields: [shippingMethodId], references: [id])
  shippingMethodId Int?
  deliverySlot     DeliverySlot?   @relation(fields: [deliverySlotId], references: [id])
  deliverySlotId   Int?
  savedCart       SavedCart?
  abandonedCartRecovery AbandonedCartRecovery?
  subtotal         Decimal         @default(0)
  discountAmount   Decimal         @default(0)
  couponDiscount   Decimal         @default(0)
  shippingCharge   Decimal         @default(0)
  taxAmount        Decimal         @default(0)
  totalAmount      Decimal         @default(0)
  status           CartStatus      @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  createdBy        Int?
  updatedBy        Int?
}

model CartItem {
  id         Int            @id @default(autoincrement())
  cart       Cart           @relation(fields: [cartId], references: [id])
  cartId     Int
  product    Product        @relation(fields: [productId], references: [id])
  productId  Int
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  variantId  Int?
  quantity   Int             @default(1)
  unitPrice  Decimal
  discount   Decimal         @default(0)
  tax        Decimal         @default(0)
  total      Decimal
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model Coupon {
  id                         Int          @id @default(autoincrement())
  couponCode                 String       @unique
  title                      String
  description                String?
  couponType                 CouponType   @default(FLAT)
  percentage                 Int?         
  flatAmount                 Decimal?     
  maximumDiscount            Decimal?     
  minimumOrderAmount         Decimal?     
  usageLimit                 Int?         
  usagePerCustomer           Int?         
  startDate                  DateTime
  endDate                    DateTime
  applicableCategories       Json?
  applicableProducts         Json?
  applicableCustomerGroups   Json?
  status                     MasterStatus @default(ACTIVE)
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  usages                     CouponUsage[]
  carts                      Cart[]
  orders                     Order[]
}

model CouponUsage {
  id             Int      @id @default(autoincrement())
  customer       Customer @relation(fields: [customerId], references: [id])
  customerId     Int
  coupon         Coupon   @relation(fields: [couponId], references: [id])
  couponId       Int
  orderId        Int?
  discountAmount Decimal
  usedAt         DateTime @default(now())
}

enum BannerDisplayOn {
  HOME
  PRODUCT_PAGE
  CATEGORY_PAGE
  ALL
}

enum BannerPosition {
  TOP
  MIDDLE
  BOTTOM
  SIDEBAR
}

enum MarketingSectionType {
  HERO_SLIDER
  FEATURED_PRODUCTS
  TRENDING_PRODUCTS
  NEW_ARRIVALS
  BEST_SELLERS
  RECENTLY_VIEWED
  RECOMMENDED_PRODUCTS
  BRANDS
  CATEGORIES
  TESTIMONIALS
  INSTAGRAM_FEED
  BLOG_SECTION
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  DRAFT
}

enum CampaignType {
  FLASH_SALE
  DEAL_OF_THE_DAY
  COMBO_OFFER
  BUY_X_GET_Y
  REFERRAL
  POPUP
  EMAIL
  SMS
  WHATSAPP
  PUSH
  GENERAL
}

enum PromotionDiscountType {
  PERCENTAGE
  FLAT
}

enum GiftCardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}

enum ReferralStatus {
  ACTIVE
  EXPIRED
  COMPLETED
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
}

enum PopupType {
  INFO
  OFFER
  EMAIL_CAPTURE
  COUPON
}

enum MarketingChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum AbandonedCartRecoveryStatus {
  PENDING
  SCHEDULED
  RECOVERED
  FAILED
}

enum StoreCreditType {
  CREDIT
  DEBIT
  ADJUSTMENT
  REWARD
}

model Banner {
  id            Int            @id @default(autoincrement())
  bannerCode    String         @unique
  title         String
  subtitle      String?
  description   String?
  imageId       Int?
  mobileImageId Int?
  buttonText    String?
  buttonUrl     String?
  position      BannerPosition @default(TOP)
  priority      Int            @default(0)
  startDate     DateTime?
  endDate       DateTime?
  displayOn     BannerDisplayOn @default(HOME)
  status        CampaignStatus @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model HomepageSection {
  id          Int                 @id @default(autoincrement())
  sectionType MarketingSectionType
  title       String
  description String?
  metadata    Json?
  priority    Int                 @default(0)
  status      CampaignStatus      @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model Campaign {
  id               Int                      @id @default(autoincrement())
  campaignCode     String                   @unique
  campaignName     String
  campaignType     CampaignType
  description      String?
  startDate        DateTime
  endDate          DateTime
  budget           Decimal                  @default(0)
  priority         Int                      @default(0)
  status           CampaignStatus           @default(DRAFT)
  flashSales       FlashSale[]
  deals            DealOfTheDay[]
  comboOffers      ComboOffer[]
  buyXGetYOffers   BuyXGetYOffer[]
  channelCampaigns MarketingChannelCampaign[]
  analytics        CampaignAnalytics[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
}

model FlashSale {
  id                        Int            @id @default(autoincrement())
  campaign                  Campaign?      @relation(fields: [campaignId], references: [id])
  campaignId                Int?
  flashSaleName             String
  startDate                 DateTime
  endDate                   DateTime
  products                  Json?
  discountType              PromotionDiscountType
  discountValue             Decimal
  maximumDiscount           Decimal?       @default(0)
  maximumQuantityPerCustomer Int?          @default(0)
  status                    CampaignStatus @default(ACTIVE)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
}

model DealOfTheDay {
  id          Int            @id @default(autoincrement())
  campaign    Campaign?      @relation(fields: [campaignId], references: [id])
  campaignId  Int?
  product     Product        @relation(fields: [productId], references: [id])
  productId   Int
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  variantId   Int?
  startDate   DateTime
  endDate     DateTime
  offerPrice  Decimal
  status      CampaignStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ComboOffer {
  id           Int            @id @default(autoincrement())
  campaign     Campaign?      @relation(fields: [campaignId], references: [id])
  campaignId   Int?
  offerName    String
  productIds   Json?
  bundlePrice  Decimal
  discount     Decimal        @default(0)
  status       CampaignStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model BuyXGetYOffer {
  id            Int            @id @default(autoincrement())
  campaign      Campaign?      @relation(fields: [campaignId], references: [id])
  campaignId    Int?
  buyProductId  Int
  buyVariantId  Int?
  buyQuantity   Int            @default(1)
  getProductId  Int
  getVariantId  Int?
  getQuantity   Int            @default(1)
  discount      Decimal        @default(0)
  status        CampaignStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model GiftCard {
  id            Int             @id @default(autoincrement())
  giftCardCode  String          @unique
  amount        Decimal
  balance       Decimal         @default(0)
  expiryDate    DateTime
  status        GiftCardStatus  @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model ReferralProgram {
  id             Int            @id @default(autoincrement())
  referralCode   String         @unique
  referrerReward Decimal
  refereeReward  Decimal
  startDate      DateTime
  endDate        DateTime
  status         ReferralStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model StoreCreditTransaction {
  id           Int              @id @default(autoincrement())
  customer     Customer         @relation(fields: [customerId], references: [id])
  customerId   Int
  type         StoreCreditType
  creditAmount Decimal          @default(0)
  debitAmount  Decimal          @default(0)
  balance      Decimal          @default(0)
  reason       String?
  reference    String?
  createdAt    DateTime         @default(now())
}

model NewsletterSubscriber {
  id           Int              @id @default(autoincrement())
  email        String           @unique
  status       SubscriberStatus @default(ACTIVE)
  subscribedAt DateTime         @default(now())
  unsubscribedAt DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model MarketingChannelCampaign {
  id              Int              @id @default(autoincrement())
  campaign        Campaign?        @relation(fields: [campaignId], references: [id])
  campaignId      Int?
  name            String
  channel         MarketingChannel
  subject         String?
  message         String
  targetAudience  String?
  payload         Json?
  scheduleAt      DateTime?
  status          CampaignStatus  @default(DRAFT)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  analytics       CampaignAnalytics[]
}

model LandingPage {
  id           Int            @id @default(autoincrement())
  slug         String         @unique
  seoTitle     String
  seoDescription String?
  metaKeywords String?
  canonicalUrl String?
  bannerId     Int?
  sections     Json?
  status       CampaignStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model AnnouncementBar {
  id          Int          @id @default(autoincrement())
  title       String
  message     String
  buttonText  String?
  buttonUrl   String?
  displayRule String?
  priority    Int          @default(0)
  startDate   DateTime?
  endDate     DateTime?
  status      CampaignStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model PopupCampaign {
  id          Int          @id @default(autoincrement())
  popupType   PopupType
  imageId     Int?
  offerText   String?
  displayRule String?
  frequency   String?
  startDate   DateTime?
  endDate     DateTime?
  status      CampaignStatus @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model AbandonedCartRecovery {
  id              Int                         @id @default(autoincrement())
  customer        Customer?                   @relation(fields: [customerId], references: [id])
  customerId      Int?
  cart            Cart?                       @relation(fields: [cartId], references: [id])
  cartId          Int?                        @unique
  reminderCount   Int                         @default(0)
  lastReminderDate DateTime?
  nextReminderAt  DateTime?
  recoveryStatus  AbandonedCartRecoveryStatus @default(PENDING)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
}

model MarketingTag {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  slug        String       @unique
  description String?
  metadata    Json?
  status      MasterStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model CampaignAnalytics {
  id                 Int              @id @default(autoincrement())
  campaign           Campaign?        @relation(fields: [campaignId], references: [id])
  campaignId         Int?
  channelCampaign    MarketingChannelCampaign? @relation(fields: [channelCampaignId], references: [id])
  channelCampaignId  Int?
  impressions        Int              @default(0)
  clicks             Int              @default(0)
  conversions        Int              @default(0)
  revenue            Decimal          @default(0)
  ctr                Float            @default(0)
  conversionRate     Float            @default(0)
  roi                Float            @default(0)
  date               DateTime         @default(now())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model ShippingMethod {
  id          Int          @id @default(autoincrement())
  name        String
  code        String       @unique
  description String?
  status      MasterStatus @default(ACTIVE)
  charges     ShippingCharge[]
  carts       Cart[]
  orders      Order[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ShippingZone {
  id          Int          @id @default(autoincrement())
  name        String
  country     String
  state       String?
  city        String?
  postalCode  String?
  status      MasterStatus @default(ACTIVE)
  charges     ShippingCharge[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ShippingCharge {
  id              Int             @id @default(autoincrement())
  shippingMethod  ShippingMethod  @relation(fields: [shippingMethodId], references: [id])
  shippingMethodId Int
  zone            ShippingZone    @relation(fields: [zoneId], references: [id])
  zoneId          Int
  minimumWeight   Float?          @default(0)
  maximumWeight   Float?          @default(0)
  charge          Decimal         @default(0)
  status          MasterStatus    @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model DeliverySlot {
  id                Int          @id @default(autoincrement())
  date              DateTime
  startTime         String
  endTime           String
  capacity          Int          @default(0)
  remainingCapacity Int          @default(0)
  status            MasterStatus @default(ACTIVE)
  carts             Cart[]
  orders            Order[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model SavedCart {
  id          Int      @id @default(autoincrement())
  customer    Customer @relation(fields: [customerId], references: [id])
  customerId  Int
  cart        Cart     @relation(fields: [cartId], references: [id])
  cartId      Int      @unique
  name        String?  
  status      MasterStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum OrderType {
  ONLINE
  OFFLINE
  PHONE
  B2B
  B2C
}

enum OrderSource {
  WEB
  MOBILE
  STORE
  MARKETPLACE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  READY_TO_SHIP
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
  FAILED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  CANCELLED
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum RefundMode {
  BANK_TRANSFER
  WALLET
  CREDIT_NOTE
  OTHER
}

enum PaymentMethodType {
  CASH_ON_DELIVERY
  UPI
  CREDIT_CARD
  DEBIT_CARD
  NET_BANKING
  WALLET
  GIFT_CARD
}

enum PaymentGatewayProvider {
  RAZORPAY
  STRIPE
  PAYPAL
